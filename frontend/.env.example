# ── Local development ──────────────────────────────────────────────────────────
# Backend API base URL (Express). Used by client-side axios calls.
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL (Express WS server).
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── Vercel (production) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL should be set to your public domain in Vercel env vars,
# e.g. https://your-project.vercel.app  (browser calls go through the CDN edge).
#
# BACKEND_URL is injected automatically by the Vercel service binding defined in
# vercel.json — DO NOT set this variable manually in Vercel environment variables.
# It resolves to the backend service's internal URL at runtime (server-side only).
